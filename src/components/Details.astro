---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { getPhoto } from '../config/photos';
import { strings, type Lang } from '../i18n/content';
import { url, pagePath } from '../lib/urls';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = strings[lang];
const photoA = getPhoto('living-room-with-balcony-access.jpg');
const photoB = getPhoto('private-balcony.jpg');
const alt = (p: typeof photoA) => (lang === 'ar' ? p.altAr : p.altEn);
---
<section id="chalet" class="section" aria-labelledby="chalet-title">
  <div class="container">
    <div class="summary-card">
      <h2 class="summary-title">{s.summary.heading}</h2>
      <p>{s.summary.text}</p>
    </div>

    <div class="details-grid">
      <div class="details-copy">
        <h2 id="chalet-title">{s.details.heading}</h2>
        {s.details.intro.map((p) => <p class="lead-p">{p}</p>)}
        <h3 class="list-heading">{s.details.listHeading}</h3>
        <ul class="detail-list">
          {s.details.items.map((it) => (
            <li>
              <Icon name="Check" size={20} />
              <div><strong>{it.title}</strong><span>{it.text}</span></div>
            </li>
          ))}
        </ul>
        <p class="note"><Icon name="Info" size={18} /> <span>{s.details.sharedNote}</span></p>
        <div class="row-ctas">
          <WhatsAppButton lang={lang} placement="details" label={s.wa.check} />
          <a class="text-link" href={url(pagePath(lang, 'gallery'))}>{s.details.viewAll}</a>
        </div>
      </div>
      <div class="details-media">
        <Picture src={photoA.src} alt={alt(photoA)} formats={['webp']} fallbackFormat="jpg" widths={[400, 640, 900]} sizes="(min-width: 960px) 30vw, 50vw" loading="lazy" class="dm-a" />
        <Picture src={photoB.src} alt={alt(photoB)} formats={['webp']} fallbackFormat="jpg" widths={[400, 640, 900]} sizes="(min-width: 960px) 30vw, 50vw" loading="lazy" class="dm-b" />
      </div>
    </div>
  </div>
</section>
