---
import WhatsAppButton from './WhatsAppButton.astro';
import SocialLinks from './SocialLinks.astro';
import { contact } from '../config/site';
import { strings, languages, languageNames, type Lang } from '../i18n/content';
import { url, pagePath, type PageKey } from '../lib/urls';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const s = strings[lang];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-name">{s.propertyName}</p>
      <p class="footer-loc">{s.hero.location}</p>
      <p class="footer-phone"><span>{s.contact.numberLabel}:</span> <a href={`https://wa.me/${contact.whatsappWaMe}`} target="_blank" rel="noopener noreferrer" dir="ltr" data-wa="footer-number">{contact.whatsappDisplay}</a></p>
      <div class="footer-cta"><WhatsAppButton lang={lang} placement="footer" variant="light" /></div>
    </div>
    <div>
      <p class="footer-h">{s.contact.followHeading}</p>
      <SocialLinks lang={lang} variant="list" />
    </div>
    <div>
      <p class="footer-h">{s.footer.language}</p>
      <ul class="footer-langs">
        {languages.map((l) => (
          <li><a href={url(pagePath(l, page))} hreflang={l} lang={l} dir={strings[l].dir} data-lang-switch={l} aria-current={lang === l ? 'true' : undefined}>{languageNames[l]}</a></li>
        ))}
      </ul>
      <p class="footer-h">{s.nav.label}</p>
      <ul class="footer-links">
        <li><a href={url(pagePath(lang, 'home'))}>{s.nav.home}</a></li>
        <li><a href={url(pagePath(lang, 'gallery'))}>{s.footer.gallery}</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p class="disclaimer">{s.footer.disclaimer}</p>
    <p>© <span data-year>{year}</span> {s.propertyName}. {s.footer.rights}</p>
  </div>
</footer>
